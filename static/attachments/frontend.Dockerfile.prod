# Production frontend: build the static bundle, then serve it with nginx.
# Build:  docker build -f Dockerfile.prod --build-arg VITE_API_BASE=http://<backend-host>:8000 -t quickbite-frontend:prod .
FROM node:20-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
# API base is baked in at build time (Vite inlines VITE_* vars).
ARG VITE_API_BASE=
ARG VITE_BASENAME=
ENV VITE_API_BASE=$VITE_API_BASE
ENV VITE_BASENAME=$VITE_BASENAME
RUN npm run build

FROM nginx:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
